---
/**
 * Header organism. Nav + logo + mobile menu. Used by BaseLayout.
 *
 * Active route highlighting is via aria-current="page" on the
 * matching <a> (handled by per-page consumers passing the
 * currentPath prop).
 */
import { NAV, SITE } from '../../lib/site';
import { getPublicPhone } from '../../lib/phone';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const publicPhone = getPublicPhone();

const homeIntentPrompts: Record<string, string> = {
  '/mineral-rights-value/':
    'I want to understand what my mineral rights may be worth and which details matter most.',
  '/offer-review/':
    'I received an offer for my mineral rights and want help understanding whether it is fair.',
  '/inherited-mineral-rights/':
    'I inherited mineral rights and need help figuring out what documents and details matter first.',
};

const getHomeIntentPrompt = (href: string) =>
  currentPath === '/' ? homeIntentPrompts[href] : undefined;
---

<header class="header" role="banner">
  <div class="container">
    <div class="header__inner">
      <a class="header__brand" href="/" aria-label={`${SITE.name} home`}>
        <img src="/assets/brand/mrx-logo-color.webp" alt={SITE.name} width="400" height="100" />
      </a>
      <nav class="header__nav" aria-label="Primary">
        {
          NAV.primary.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              aria-haspopup={getHomeIntentPrompt(item.href) ? 'dialog' : undefined}
              data-travis-prompt={getHomeIntentPrompt(item.href)}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="header__actions">
        <a
          class="header__account"
          href="/book/"
          aria-current={currentPath === '/book/' ? 'page' : undefined}>Free review</a
        >
        <button
          class="header__account"
          type="button"
          data-account-route
          aria-current={currentPath === '/account/' ? 'page' : undefined}>Log In</button
        >
        <a
          class="header__phone"
          href={publicPhone.href}
          aria-label={publicPhone.label}
          data-cta-name="header-call-mrx"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M6.7 2.8 9.3 8l-2 2a16 16 0 0 0 6.7 6.7l2-2 5.2 2.6v3.2c0 .9-.7 1.7-1.7 1.7A17.7 17.7 0 0 1 1.8 4.5c0-.9.8-1.7 1.7-1.7h3.2Z"
            ></path>
          </svg>
        </a>
        <button
          class="header__ask"
          type="button"
          aria-label="Ask Travis for mineral-rights help"
          data-open-travis
          data-cta-name="header-ask-travis"
        >
          <img
            src="/assets/mrx-homepage-v4/avatars/travis-hermes-128.webp"
            alt="Travis, fictional MRX AI guide"
            width="128"
            height="128"
            aria-hidden="true"
          />
          <span><strong>Ask Travis</strong><small>Straight answers, 24/7</small></span>
        </button>
        <button
          class="header__toggle"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-mobile-toggle
        >
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"
          ></span>
        </button>
      </div>
    </div>
    <nav class="mobile-nav" id="mobile-nav" data-open="false" aria-label="Mobile primary">
      <ul>
        {
          NAV.primary.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                aria-haspopup={getHomeIntentPrompt(item.href) ? 'dialog' : undefined}
                data-travis-prompt={getHomeIntentPrompt(item.href)}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/book/" aria-current={currentPath === '/book/' ? 'page' : undefined}
            >Book a free review</a
          >
        </li>
        <li>
          <button
            class="mobile-nav__account"
            type="button"
            data-account-route
            aria-current={currentPath === '/account/' ? 'page' : undefined}>Log In</button
          >
        </li>
        <li>
          <button class="mobile-nav__ask" type="button" data-open-travis
            ><img
              src="/assets/mrx-homepage-v4/avatars/travis-hermes-128.webp"
              alt="Travis, fictional MRX AI guide"
              width="128"
              height="128"
              aria-hidden="true"
            /> Ask Travis for help</button
          >
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Keep the mobile menu and homepage assistant entry points lightweight.
  const btn = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.getAttribute('data-open') === 'true';
      nav.setAttribute('data-open', open ? 'false' : 'true');
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  }
  document.querySelectorAll<HTMLElement>('[data-open-travis]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('mrx:open-chat', { detail: { guide: 'travis', opener: trigger } }),
      );
      nav?.setAttribute('data-open', 'false');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-travis-prompt]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      const prompt = trigger.dataset.travisPrompt;
      window.dispatchEvent(new CustomEvent('mrx:open-chat', { detail: { prompt } }));
      nav?.setAttribute('data-open', 'false');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-account-route]').forEach((trigger) => {
    trigger.addEventListener('click', () => window.location.assign('/account/'));
  });
</script>

<style>
  .header__phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    box-sizing: border-box;
    border: 2px solid var(--mrx-gold);
    border-radius: 999px;
    background: #fffaf0;
    color: var(--mrx-navy);
    box-shadow: 0 8px 20px rgba(7, 30, 52, 0.1);
    text-decoration: none;
    transition:
      background 0.18s ease,
      color 0.18s ease,
      transform 0.18s ease;
  }

  .header__phone:hover {
    background: var(--mrx-navy);
    color: #fff;
    transform: translateY(-1px);
  }

  .header__phone:focus-visible {
    outline: 3px solid #1b6da8;
    outline-offset: 2px;
  }

  .header__phone svg {
    width: 21px;
    height: 21px;
    fill: currentColor;
  }

  @media (max-width: 360px) {
    .header__inner {
      gap: 0.25rem;
    }

    .header__actions {
      gap: 0.2rem;
    }

    .header__brand img {
      width: min(124px, 39vw);
    }
  }
</style>
