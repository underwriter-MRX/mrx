---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import AccountHub from '../../components/react/AccountHub';
import { getSupabasePublicConfig } from '../../lib/platform/supabase';
export const prerender = false;
const supabasePublicConfig = getSupabasePublicConfig();
---

<MarketingLayout
  title="Your Private MRX Owner Account"
  description="Return to your private Mineral Rights Xchange conversations, cited answers, appointments, communication preferences, and securely uploaded documents."
  path="/account/"
  pageType="utility"
  pageCategory="account"
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Account', path: '/account/' },
  ]}
>
  <section class="mrx-section mrx-section--sand">
    <div class="container">
      <AccountHub
        client:load
        supabaseUrl={supabasePublicConfig?.url}
        supabaseAnonKey={supabasePublicConfig?.anonKey}
      />
    </div>
  </section>
</MarketingLayout>
