---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import BeforeYouSellGuideForm from '../components/organisms/BeforeYouSellGuideForm.astro';
export const prerender = true;
const title = 'Before You Sell Your Mineral Rights - Free Guide | MRX';
const description =
  'Before accepting an offer, know what to ask. Get the free MRX guide with seven practical questions and an offer-comparison worksheet.';
const artwork = '/assets/guides/before-you-sell-mineral-rights/approved-guide-promo.webp';
const infographicAlt =
  'Mineral Rights Xchange. BEFORE YOU ACCEPT AN OFFER. An offer is more than a dollar amount. Travis · Fictional AI guide. 01 What do you own? 02 What is your goal? 03 What would the buyer receive? 04 What assumptions support the price? 05 What can change before closing? 06 Who is buying and how will you be paid? 07 What still needs an answer? Get the free guide Before You Sell Your Mineral Rights. 7 questions + an offer-comparison worksheet. MineralRightsXchange.com. Educational guide. No obligation to sell.';
const faq = [
  {
    question: 'Does this guide tell me what my mineral rights are worth?',
    answer:
      'No. It helps you compare written terms, identify missing information, and prepare questions. It does not provide an appraisal or individualized legal, tax, or valuation advice.',
  },
  {
    question: 'Do I have to agree to texts or a call?',
    answer:
      'No. Your name, email, and email delivery permission are required. AI text replies, a one-time text link, marketing emails, and a human call are separate optional choices. You can get the guide by email without choosing any of them.',
  },
];
---

<MarketingLayout
  title={title}
  description={description}
  path="/before-you-sell-mineral-rights/"
  ogImage={artwork}
  ogImageAlt={infographicAlt}
  ogImageWidth={1122}
  ogImageHeight={1402}
  ogImageType="image/webp"
  pageType="marketing"
  pageCategory="decision-guide"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Before You Sell Your Mineral Rights', path: '/before-you-sell-mineral-rights/' },
  ]}
  faq={faq}
>
  <section class="guide-hero" aria-labelledby="guide-title">
    <div class="container">
      <div class="guide-intro">
        <p class="kicker">Free guide + offer-comparison worksheet</p>
        <h1 id="guide-title">Before you accept an offer, know what to ask.</h1>
        <p>
          Get <strong>Before You Sell Your Mineral Rights</strong>: seven practical questions to ask
          before accepting an offer, plus a worksheet to compare the written terms.
        </p>
        <a class="mobile-jump" href="#get-the-guide">Get my free guide ↓</a>
      </div>
      <div class="guide-grid">
        <div class="guide-artwork">
          <img src={artwork} alt={infographicAlt} width="1122" height="1402" fetchpriority="high" />
          <p class="byline">
            By Travis, MRX AI Guide<br /><small
              >Fictional AI guide • Published by Mineral Rights Xchange</small
            >
          </p>
          <p>
            Use the guide to organize your information and make your next conversation more useful.
            You do not need to decide to sell.
          </p>
        </div>
        <div class="guide-optin">
          <div
            class="book-detail"
            role="img"
            aria-label="Hardcover-style promotion for the free digital guide Before You Sell Your Mineral Rights. Seven questions and an offer-comparison worksheet."
          >
            <img src={artwork} alt={infographicAlt} width="1122" height="1402" aria-hidden="true" />
          </div>
          <section id="get-the-guide" class="guide-form-card" aria-labelledby="get-guide-title">
            <p class="kicker">Your free copy</p>
            <h2 id="get-guide-title">Get your free guide.</h2>
            <p>
              Download the PDF after submitting your request. We will also request email delivery.
              Text delivery and conversations with Travis are optional.
            </p>
            <BeforeYouSellGuideForm sourceSurface="landing" compact={true} />
          </section>
        </div>
      </div>
    </div>
  </section>
  <section class="worksheet-section">
    <div class="container worksheet-grid">
      <div>
        <p class="kicker">Included in your free guide</p>
        <h2>Put the terms side by side.</h2>
        <p>
          The offer-comparison worksheet gives you a place to record what each offer includes, what
          might change, and what still needs an answer.
        </p>
        <ul>
          <li>Compare the interest and property scope.</li><li>
            Record price assumptions, adjustments, and deadlines.
          </li><li>Bring your unanswered questions to the next conversation.</li>
        </ul>
        <p class="note">
          A worksheet for organizing information, not an appraisal or an automatic estimate of
          value.
        </p>
        <a class="guide-cta" href="#get-the-guide">Get the guide + worksheet →</a>
      </div>
      <figure>
        <img
          src="/assets/guides/before-you-sell-mineral-rights/offer-comparison-worksheet.webp"
          alt="MRX / BEFORE YOU SELL YOUR MINERAL RIGHTS. WORKSHEET 01. Put the offers side by side. Use the actual written terms. Leave blanks or write 'unknown' when something is missing. Keep this worksheet with your documents; it is not a valuation or a winner score. TERM TO CHECK. OFFER A. OFFER B. Buyer / offer date. Interest type and location. Exact rights and depths. Headline total and basis. Stated acres and unit. Assumptions / records used. Possible price adjustments. Diligence / extensions. Closing / final payment. Effective date / receivables. Rights retained / obligations. Questions still unanswered. Compare the same asset and conditions before relying on totals. Neither this table nor a per-acre calculation determines value or which offer you should accept. Optional online companion: mineralrightsxchange.com/mineral-rights-offer-comparison/. 10. Travis: fictional AI guide | Published by Mineral Rights Xchange."
          width="918"
          height="1188"
          loading="lazy"
        /><figcaption>The offer-comparison worksheet included in the guide.</figcaption>
      </figure>
    </div>
  </section>
  <section class="container guide-next">
    <div>
      <p class="kicker">Already have your copy?</p><h2>Ask your next question.</h2><p>
        Tell Travis what you are trying to understand about your offer.
      </p>
    </div>
    <button class="ask-travis" type="button" data-open-travis
      ><img
        src="/assets/mrx-homepage-v4/avatars/travis-hermes-128.webp"
        width="128"
        height="128"
        alt="Travis, fictional MRX AI guide"
      /><span><strong>Ask Travis</strong><small>MRX’s fictional AI guide</small></span></button
    >
  </section>
  <section class="container guide-faq">
    <h2>Questions about the free guide</h2>{
      faq.map((item) => (
        <details>
          <>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </>
        </details>
      ))
    }<p>
      <a href="/mineral-rights-offer-comparison/">Compare two written offers</a> · <a
        href="/offer-review/">Learn about offer review</a
      > · <a href="/free-guide/">Find ownership records</a>
    </p>
  </section>
</MarketingLayout>
<style>
  .guide-hero {
    background: #fbfaf6;
    padding: clamp(1.5rem, 4vw, 3rem) 0 4rem;
  }
  .guide-intro {
    max-width: 920px;
    margin-bottom: 2rem;
  }
  .kicker {
    color: #94620c;
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .guide-intro h1 {
    font-size: clamp(2.1rem, 4vw, 3.7rem);
    line-height: 1.07;
    color: #051a2e;
    margin: 0.5rem 0 1rem;
  }
  .guide-intro > p:last-of-type {
    font-size: 1.1rem;
    max-width: 780px;
  }
  .guide-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }
  .guide-artwork > img {
    width: 100%;
    height: auto;
    box-shadow: 0 18px 36px #051a2e1a;
  }
  .byline {
    font-weight: 700;
    margin-top: 1.25rem;
  }
  .byline small {
    font-weight: 400;
  }
  .book-detail {
    position: relative;
    aspect-ratio: 1122/430;
    overflow: hidden;
    margin-bottom: 1rem;
  }
  .book-detail img {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: auto;
    max-width: none;
  }
  .guide-form-card {
    background: white;
    padding: clamp(1rem, 2.5vw, 2rem);
    border: 1px solid #d6dfe1;
    border-radius: 1.25rem;
    box-shadow: 0 12px 30px #051a2e0b;
    scroll-margin-top: 7rem;
  }
  .guide-form-card h2 {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    margin: 0.5rem 0;
  }
  .worksheet-section {
    background: #f1eee5;
    padding: 4rem 0;
  }
  .worksheet-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .worksheet-grid h2,
  .guide-next h2 {
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    line-height: 1.15;
  }
  .worksheet-grid li {
    margin-bottom: 0.7rem;
  }
  .worksheet-grid figure {
    margin: 0;
    max-width: 470px;
    justify-self: center;
  }
  .worksheet-grid img {
    width: 100%;
    height: auto;
    box-shadow: 0 14px 40px #051a2e26;
  }
  .worksheet-grid figcaption,
  .note {
    font-size: 0.85rem;
    color: #455a6b;
  }
  .guide-cta,
  .mobile-jump {
    display: inline-block;
    background: #d8951f;
    color: #051a2e;
    border-radius: 0.75rem;
    padding: 0.9rem 1.15rem;
    font-weight: 800;
    text-decoration: none;
  }
  .guide-next {
    padding-block: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .ask-travis {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #051a2e;
    color: #fff;
    border: 0;
    border-radius: 99px;
    padding: 0.6rem 1.3rem 0.6rem 0.6rem;
    cursor: pointer;
    flex-shrink: 0;
  }
  .ask-travis img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid #d8951f;
  }
  .ask-travis span {
    display: grid;
    text-align: left;
  }
  .ask-travis small {
    font-size: 0.72rem;
  }
  .guide-faq {
    padding-bottom: 3rem;
    max-width: 850px;
  }
  .guide-faq details {
    border-bottom: 1px solid #ccd4da;
    padding: 1rem 0;
  }
  .guide-faq summary {
    font-weight: 700;
    cursor: pointer;
  }
  .mobile-jump {
    display: none;
  }
  @media (max-width: 760px) {
    .guide-grid,
    .worksheet-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .guide-optin {
      order: -1;
    }
    .guide-artwork {
      max-width: 600px;
      margin: auto;
    }
    .guide-next {
      flex-direction: column;
      align-items: flex-start;
    }
    .mobile-jump {
      display: inline-block;
    }
    .worksheet-section {
      padding: 2.5rem 0;
    }
  }
</style>
