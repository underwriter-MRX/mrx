---
/**
 * /book/thank-you. Redirect target after the /api/book POST.
 * Page views are not proof of a submitted request or confirmed appointment.
 * Noindex by default; this is not a public landing page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBlock from '../../components/molecules/CtaBlock.astro';
import Heading from '../../components/atoms/Heading.astro';
import Text from '../../components/atoms/Text.astro';
export const prerender = true;
---

<BaseLayout
  title="Next steps for your review · Mineral Rights Xchange"
  description="Find the next step for an educational mineral-rights conversation. A review request does not confirm an appointment."
  path="/book/thank-you"
  noindex={true}
  pageType="utility"
  pageCategory="thank-you"
>
  <section class="container container--narrow section" style="text-align: center;">
    <Heading level={1} size="3xl">Next steps for your review</Heading>
    <Text class="text--lead" style="margin-top: var(--space-4);"
      >If you submitted a review request, the MRX team can follow up as availability permits. This
      page does not confirm an appointment. Use the appointment assistant to choose an available
      time, or keep reading the educational resources.</Text
    >
  </section>
  <CtaBlock
    title="Choose your next step"
    body="You can request a phone conversation with the human MRX team or keep researching on your own."
    primaryCta={{
      label: 'Find a phone time',
      href: '/book/',
      ctaName: 'book-thank-you-schedule',
    }}
    secondaryCta={{
      label: 'Download the Free Guide',
      href: '/free-guide',
      ctaName: 'book-thank-you-guide',
    }}
  />
</BaseLayout>
