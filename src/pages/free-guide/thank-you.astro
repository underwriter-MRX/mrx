---
/**
 * /free-guide/thank-you. Redirect target after the /api/free-guide POST.
 * Accepted requests are measured by the API, never by viewing this page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBlock from '../../components/molecules/CtaBlock.astro';
import Heading from '../../components/atoms/Heading.astro';
import Text from '../../components/atoms/Text.astro';
import { GUIDE_DOWNLOAD_PATH, GUIDE_TITLE } from '../../lib/form';
export const prerender = true;
---

<BaseLayout
  title="Open your free guide · Mineral Rights Xchange"
  description="Open the free MRX mineral-rights guide and prepare questions about ownership records and third-party offers."
  path="/free-guide/thank-you"
  noindex={true}
  pageType="utility"
  pageCategory="thank-you"
>
  <section class="container container--narrow section" style="text-align: center;">
    <Heading level={1} size="3xl">Open your free mineral-rights guide</Heading>
    <Text class="text--lead" style="margin-top: var(--space-4);"
      >You can open the guide below. If you requested an email copy, check your inbox. This page
      does not verify email delivery. The guide is general educational information, not legal, tax,
      or valuation advice.</Text
    >
    <p style="margin-top: var(--space-5);">
      <a
        class="btn btn--primary btn--lg"
        href={GUIDE_DOWNLOAD_PATH}
        data-cta-name="fg-thank-you-open-guide"
      >
        Open {GUIDE_TITLE}
      </a>
    </p>
  </section>
  <CtaBlock
    title="Want a transparent review?"
    body="Prepare questions for a free educational conversation with the human MRX team. No card required and no obligation."
    primaryCta={{ label: 'Book My Free Review', href: '/book', ctaName: 'fg-thank-you-book' }}
  />
</BaseLayout>
