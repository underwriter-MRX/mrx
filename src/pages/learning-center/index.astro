---
import LearningCenterPage from '../../components/organisms/LearningCenterPage.astro';
import { paginateArchive } from '../../lib/archive-pagination';
import { getLearningCenterData } from '../../lib/learning-center';

export const prerender = true;

const { items, categories, authors } = await getLearningCenterData();
const page = paginateArchive(items, 1);
---

<LearningCenterPage {...page} categories={categories} authors={authors} />
