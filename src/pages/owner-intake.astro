---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import AccountHub from '../components/react/AccountHub';
import { getSupabasePublicConfig } from '../lib/platform/supabase';
export const prerender = false;
const supabasePublicConfig = getSupabasePublicConfig();
---

<MarketingLayout
  title="Guided Mineral Owner Intake"
  description="Start a secure MRX owner intake, add multiple mineral properties, upload supporting documents, and prepare for Senior Underwriter review."
  path="/owner-intake/"
  pageType="utility"
  pageCategory="account"
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Owner Intake', path: '/owner-intake/' },
  ]}
>
  <section class="mrx-section mrx-section--sand">
    <div class="container">
      <AccountHub
        client:load
        supabaseUrl={supabasePublicConfig?.url}
        supabaseAnonKey={supabasePublicConfig?.anonKey}
      />
    </div>
  </section>
</MarketingLayout>
