---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import StaffPortal from '../../components/react/StaffPortal';
import { getSupabasePublicConfig } from '../../lib/platform/supabase';
export const prerender = false;
const supabasePublicConfig = getSupabasePublicConfig();
---

<MarketingLayout
  title="Protected MRX Staff Portal"
  description="Role- and assignment-protected MRX owner case review."
  path="/staff/"
  pageType="utility"
  pageCategory="staff"
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Staff', path: '/staff/' },
  ]}
>
  <section class="mrx-section mrx-section--sand staff-portal-section">
    <div class="container staff-portal-container">
      <StaffPortal
        client:load
        supabaseUrl={supabasePublicConfig?.url}
        supabaseAnonKey={supabasePublicConfig?.anonKey}
      />
    </div>
  </section>
</MarketingLayout>
