---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { guides, type Guide } from '../../data/guides';
export const prerender = true;
export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props as { guide: Guide };
const seoTitle = `Meet ${guide.name}: ${guide.shortRole.replace('professional-', '')} | MRX AI Guide`;
const seoDescription = `${guide.name} is a fictional MRX AI Guide for ${guide.helpsWith.slice(0, 3).join(', ').toLowerCase()}. See the role, limitations, and how to ask for focused help.`;
---

<MarketingLayout
  title={seoTitle}
  description={seoDescription}
  path={`/team/${guide.slug}/`}
  pageType="marketing"
  pageCategory="about"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'MRX AI Guides', path: '/team/' },
    { name: guide.name, path: `/team/${guide.slug}/` },
  ]}
>
  <section class="mrx-section">
    <div class="container mrx-guide-profile">
      <img
        src={guide.image.replace('-256', '-512')}
        alt={`${guide.name}, ${guide.role}`}
        width="512"
        height="512"
      /><div>
        <p class="mrx-guide-label">
          {
            guide.status === 'active'
              ? 'Active fictional MRX AI Guide'
              : 'Fictional MRX AI Guide directory profile'
          }
        </p><h1>Meet {guide.name}, {guide.shortRole}</h1><p class="mrx-guide-profile__role">
          {guide.role}
        </p><p class="mrx-guide-profile__summary">{guide.summary}</p><h2>
          What {guide.name} can help organize
        </h2><ul>{guide.helpsWith.map((item) => <li>✓ {item}</li>)}</ul><h2>
          How {guide.name} guides the conversation
        </h2><blockquote class="mrx-guide-profile__quote">
          “{guide.greeting}”
        </blockquote><div class="mrx-guide-disclosure">
          <strong>Visible limit</strong><p>{guide.limits}</p>
        </div>{
          guide.status === 'active' ? (
            <button
              class="mrx-primary mrx-guide-profile__action"
              type="button"
              data-guide-prompt={`I would like ${guide.name} to help with ${guide.shortRole.toLowerCase()}.`}
            >
              Ask {guide.name}
            </button>
          ) : (
            <p class="mrx-guide-profile__action">
              <a href="/team/travis/">Start with Travis, the active first-response guide →</a>
            </p>
          )
        }
      </div>
    </div>
  </section>
  <section class="mrx-guide-directory" aria-labelledby="other-guides-title">
    <div class="container">
      <p class="mrx-eyebrow">MRX AI Guide directory</p>
      <h2 id="other-guides-title">Explore other fictional MRX AI guides</h2>
      <p>
        Each guide has a defined educational role and visible limits. MRX Editorial Team remains
        responsible for published articles.
      </p>
      <ul>
        {
          guides
            .filter((candidate) => candidate.slug !== guide.slug)
            .map((candidate) => (
              <li>
                <a href={`/team/${candidate.slug}/`}>
                  <strong>{candidate.name}</strong>
                  <span>{candidate.shortRole}</span>
                </a>
              </li>
            ))
        }
      </ul>
    </div>
  </section>
</MarketingLayout>
<script>
  document.querySelector<HTMLElement>('[data-guide-prompt]')?.addEventListener('click', (event) => {
    const prompt = (event.currentTarget as HTMLElement).dataset.guidePrompt;
    window.dispatchEvent(new CustomEvent('mrx:open-chat', { detail: { prompt } }));
  });
</script>

<style>
  .mrx-guide-profile__role {
    color: #8a5d18;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .mrx-guide-profile__summary {
    margin-top: 1rem;
    color: #4d606c;
    font-size: 1.05rem;
  }

  .mrx-guide-profile__quote {
    padding: 1rem;
    margin-top: 0.7rem;
    border-left: 4px solid var(--mrx-gold);
    background: #fff;
  }

  .mrx-guide-profile__action {
    margin-top: 1.2rem;
  }

  .mrx-guide-directory {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
    border-top: 1px solid #d9e0e4;
    background: #f6f3ec;
  }

  .mrx-guide-directory h2 {
    max-width: 28ch;
    margin: 0;
    color: #071e34;
    font-size: clamp(1.65rem, 3vw, 2.4rem);
    line-height: 1.1;
  }

  .mrx-guide-directory .container > p:not(.mrx-eyebrow) {
    max-width: 64ch;
    margin: 0.85rem 0 1.5rem;
    color: #4f626f;
    line-height: 1.6;
  }

  .mrx-guide-directory ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mrx-guide-directory a {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    border: 1px solid #d9e0e4;
    border-radius: 12px;
    padding: 0.85rem 1rem;
    color: #071e34;
    background: #fff;
    text-decoration: none;
  }

  .mrx-guide-directory a:hover,
  .mrx-guide-directory a:focus-visible {
    border-color: #b06a00;
    box-shadow: 0 8px 22px rgba(7, 30, 52, 0.09);
  }

  .mrx-guide-directory span {
    color: #4f626f;
    font-size: 0.86rem;
  }

  @media (max-width: 760px) {
    .mrx-guide-directory ul {
      grid-template-columns: 1fr;
    }
  }
</style>
