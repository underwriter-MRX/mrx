---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { guides, type Guide } from '../../data/guides';
export const prerender = true;
export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props as { guide: Guide };
const seoTitle = `Meet ${guide.name}: ${guide.shortRole.replace('professional-', '')} | MRX AI Guide`;
const seoDescription =
  guide.slug === 'graham'
    ? 'Meet Graham, MRX’s fictional AI guide for investment questions, project opportunities, real underwriter booking, and optional appointment preparation.'
    : `${guide.name} is a fictional MRX AI Guide for ${guide.helpsWith.slice(0, 3).join(', ').toLowerCase()}. See the role, limitations, and how to ask for focused help.`;
const guidePrompt =
  guide.slug === 'graham'
    ? 'I am exploring an investment opportunity and would like Graham to help me prepare for an MRX underwriter conversation.'
    : `I would like ${guide.name} to help with ${guide.shortRole.toLowerCase()}.`;
const grahamPaths = [
  {
    label: 'Explore investing',
    prompt:
      'I am exploring an investment opportunity and would like to speak with an MRX underwriter.',
  },
  {
    label: 'Bring an opportunity',
    prompt:
      'I am bringing an opportunity for MRX human review and would like to speak with an underwriter.',
  },
  {
    label: 'Ask about a project',
    prompt: 'I am asking about a specific project and would like to speak with an MRX underwriter.',
  },
];
---

<MarketingLayout
  title={seoTitle}
  description={seoDescription}
  path={`/team/${guide.slug}/`}
  pageType="marketing"
  pageCategory="about"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'MRX AI Guides', path: '/team/' },
    { name: guide.name, path: `/team/${guide.slug}/` },
  ]}
>
  <section class="mrx-section">
    <div class="container mrx-guide-profile">
      <img
        src={guide.image.replace('-256', '-512')}
        alt={`${guide.name}, ${guide.role}`}
        width="512"
        height="512"
      /><div>
        <p class="mrx-guide-label">
          {
            guide.status === 'active'
              ? 'Active fictional MRX AI Guide'
              : 'Fictional MRX AI Guide directory profile'
          }
        </p><div class="mrx-guide-profile__heading">
          <h1>Meet {guide.name}, {guide.shortRole}</h1>
          <button
            class="mrx-guide-profile__ask"
            type="button"
            data-profile-guide={guide.slug}
            aria-label={`Ask ${guide.name} a question`}
            aria-haspopup="dialog"
          >
            <span class="mrx-guide-profile__ask-avatar" aria-hidden="true">
              <img
                src={guide.image}
                alt={`${guide.name}, ${guide.role}`}
                width="48"
                height="48"
                aria-hidden="true"
              />
              {guide.status === 'active' && <i />}
            </span>
            <span class="mrx-guide-profile__ask-label">
              <strong>Ask {guide.name}</strong>
              <small>Straight answers, 24/7</small>
            </span>
          </button>
        </div><p class="mrx-guide-profile__role">
          {guide.role}
        </p><p class="mrx-guide-profile__summary">{guide.summary}</p><h2>
          What {guide.name} can help organize
        </h2><ul>{guide.helpsWith.map((item) => <li>✓ {item}</li>)}</ul><h2>
          How {guide.name} guides the conversation
        </h2><blockquote class="mrx-guide-profile__quote">
          “{guide.greeting}”
        </blockquote><div class="mrx-guide-disclosure">
          <strong>Visible limit</strong><p>{guide.limits}</p>
        </div>{
          guide.status === 'active' && guide.slug === 'graham' ? (
            <div class="mrx-guide-profile__actions" aria-label="Choose a Graham conversation path">
              {grahamPaths.map((path) => (
                <button class="mrx-primary" type="button" data-guide-prompt={path.prompt}>
                  {path.label}
                </button>
              ))}
            </div>
          ) : guide.status === 'active' ? (
            <button
              class="mrx-primary mrx-guide-profile__action"
              type="button"
              data-guide-prompt={guidePrompt}
            >
              Ask {guide.name}
            </button>
          ) : (
            <p class="mrx-guide-profile__action">
              <a href="/team/travis/">Start with Travis, the active first-response guide →</a>
            </p>
          )
        }
      </div>
    </div>
  </section>
  <section class="mrx-guide-directory" aria-labelledby="other-guides-title">
    <div class="container">
      <p class="mrx-eyebrow">MRX AI Guide directory</p>
      <h2 id="other-guides-title">Explore other fictional MRX AI guides</h2>
      <p>
        Each guide has a defined educational role and visible limits. MRX Editorial Team remains
        responsible for published articles.
      </p>
      <ul>
        {
          guides
            .filter((candidate) => candidate.slug !== guide.slug)
            .map((candidate) => (
              <li>
                <a href={`/team/${candidate.slug}/`}>
                  <strong>{candidate.name}</strong>
                  <span>{candidate.shortRole}</span>
                </a>
              </li>
            ))
        }
      </ul>
    </div>
  </section>
</MarketingLayout>
<script>
  document.querySelectorAll<HTMLElement>('[data-profile-guide]').forEach((button) =>
    button.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('mrx:open-chat', {
          detail: { guide: button.dataset.profileGuide, opener: button },
        }),
      );
    }),
  );
  document.querySelectorAll<HTMLElement>('[data-guide-prompt]').forEach((button) =>
    button.addEventListener('click', (event) => {
      const prompt = (event.currentTarget as HTMLElement).dataset.guidePrompt;
      window.dispatchEvent(new CustomEvent('mrx:open-chat', { detail: { prompt } }));
    }),
  );
</script>

<style>
  .mrx-guide-profile__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1rem;
  }
  .mrx-guide-profile__heading h1 {
    flex: 1 1 15rem;
    margin: 0;
  }
  .mrx-guide-profile__ask {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    max-width: 100%;
    min-height: 44px;
    padding: 0.42rem 1rem 0.42rem 0.42rem;
    border: 1px solid #536879;
    border-radius: 999px;
    background: #071e34;
    color: #fff;
    box-shadow: 0 8px 24px rgba(7, 30, 52, 0.16);
    font: inherit;
    cursor: pointer;
    text-align: left;
    transition:
      background 0.15s,
      box-shadow 0.15s;
  }
  .mrx-guide-profile__ask:hover {
    background: #123b57;
    box-shadow: 0 10px 28px rgba(7, 30, 52, 0.22);
  }
  .mrx-guide-profile__ask-avatar {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
  }
  .mrx-guide-profile__ask-avatar img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border: 2px solid #d79a2b;
    border-radius: 50%;
  }
  .mrx-guide-profile__ask-avatar i {
    position: absolute;
    right: 1px;
    bottom: 2px;
    width: 12px;
    height: 12px;
    border: 2px solid #071e34;
    border-radius: 50%;
    background: #45b779;
  }
  .mrx-guide-profile__ask-label {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .mrx-guide-profile__ask-label strong {
    font-size: 0.93rem;
    font-weight: 750;
    line-height: 1.3;
  }
  .mrx-guide-profile__ask-label small {
    font-size: 0.68rem;
    line-height: 1.4;
    color: #d7e2eb;
  }
  .mrx-guide-profile__ask:focus-visible {
    outline: 3px solid #a77222;
    outline-offset: 3px;
  }
  @media (max-width: 760px) {
    .mrx-guide-profile {
      gap: 1rem;
    }
    .mrx-guide-profile > img {
      width: 80px;
      height: 80px;
      max-width: 80px;
      border-radius: 16px;
    }
    .mrx-guide-profile__heading h1 {
      font-size: clamp(1.65rem, 6vw, 2.25rem);
    }
  }

  .mrx-guide-profile__role {
    color: #8a5d18;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .mrx-guide-profile__summary {
    margin-top: 1rem;
    color: #4d606c;
    font-size: 1.05rem;
  }

  .mrx-guide-profile__quote {
    padding: 1rem;
    margin-top: 0.7rem;
    border-left: 4px solid var(--mrx-gold);
    background: #fff;
  }

  .mrx-guide-profile__action {
    margin-top: 1.2rem;
  }

  .mrx-guide-profile__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.2rem;
  }

  .mrx-guide-directory {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
    border-top: 1px solid #d9e0e4;
    background: #f6f3ec;
  }

  .mrx-guide-directory h2 {
    max-width: 28ch;
    margin: 0;
    color: #071e34;
    font-size: clamp(1.65rem, 3vw, 2.4rem);
    line-height: 1.1;
  }

  .mrx-guide-directory .container > p:not(.mrx-eyebrow) {
    max-width: 64ch;
    margin: 0.85rem 0 1.5rem;
    color: #4f626f;
    line-height: 1.6;
  }

  .mrx-guide-directory ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mrx-guide-directory a {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    border: 1px solid #d9e0e4;
    border-radius: 12px;
    padding: 0.85rem 1rem;
    color: #071e34;
    background: #fff;
    text-decoration: none;
  }

  .mrx-guide-directory a:hover,
  .mrx-guide-directory a:focus-visible {
    border-color: #b06a00;
    box-shadow: 0 8px 22px rgba(7, 30, 52, 0.09);
  }

  .mrx-guide-directory span {
    color: #4f626f;
    font-size: 0.86rem;
  }

  @media (max-width: 760px) {
    .mrx-guide-profile__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .mrx-guide-directory ul {
      grid-template-columns: 1fr;
    }
  }
</style>
